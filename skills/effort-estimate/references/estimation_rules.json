{
  "_note": "数値はすべて仮値（単位：時間）。過去実績に合わせて調整すること。値は rounding_step の倍数にし、S < M < L になるようにする。actual = AI支援ありの実作業時間、traditional = AI支援なしの従来基準（対外工数に使う）。",
  "version": "0.2.0",
  "hours_per_day": 8,
  "rounding_step": 0.25,
  "phases": {
    "investigation": "調査・設計",
    "implementation": "実装",
    "test": "テスト",
    "review": "レビュー・修正",
    "release": "リリース・確認"
  },
  "required_phases": ["investigation", "implementation", "test", "review", "release"],
  "work_types": {
    "investigation":     {"phase": "investigation",  "label": "既存コード調査・影響範囲確認",       "actual": {"S": 0.5, "M": 1.5, "L": 3},  "traditional": {"S": 1, "M": 3, "L": 6}},
    "design":            {"phase": "investigation",  "label": "設計・仕様整理（設計書作成を含む）", "actual": {"S": 0.5, "M": 2, "L": 4},    "traditional": {"S": 1, "M": 4, "L": 8}},
    "client_qa":         {"phase": "investigation",  "label": "先方との仕様確認・やり取り",         "actual": {"S": 0.5, "M": 1, "L": 2},    "traditional": {"S": 0.5, "M": 1, "L": 2}},
    "api_endpoint":      {"phase": "implementation", "label": "API追加・改修（1エンドポイント）",   "actual": {"S": 1, "M": 2, "L": 4},      "traditional": {"S": 2, "M": 4, "L": 8}},
    "business_logic":    {"phase": "implementation", "label": "ビジネスロジック変更（サービス・モデル）", "actual": {"S": 1, "M": 2.5, "L": 5}, "traditional": {"S": 2, "M": 5, "L": 10}},
    "validation":        {"phase": "implementation", "label": "バリデーション追加・変更",           "actual": {"S": 0.5, "M": 1, "L": 2},    "traditional": {"S": 1, "M": 2, "L": 4}},
    "db_migration":      {"phase": "implementation", "label": "DBマイグレーション（テーブル・カラム追加変更）", "actual": {"S": 0.5, "M": 1, "L": 3}, "traditional": {"S": 1, "M": 2, "L": 5}},
    "data_migration":    {"phase": "implementation", "label": "既存データの移行・補正",             "actual": {"S": 1, "M": 3, "L": 6},      "traditional": {"S": 2, "M": 5, "L": 10}},
    "screen_list":       {"phase": "implementation", "label": "画面（一覧・検索・詳細）",           "actual": {"S": 1, "M": 3, "L": 6},      "traditional": {"S": 2, "M": 6, "L": 12}},
    "screen_form":       {"phase": "implementation", "label": "画面（登録・編集フォーム）",         "actual": {"S": 1.5, "M": 3, "L": 6},    "traditional": {"S": 3, "M": 6, "L": 12}},
    "ui_minor":          {"phase": "implementation", "label": "文言・軽微なUI修正",                 "actual": {"S": 0.25, "M": 0.5, "L": 1}, "traditional": {"S": 0.5, "M": 1, "L": 2}},
    "auth_permission":   {"phase": "implementation", "label": "権限・認可の変更",                   "actual": {"S": 1, "M": 2, "L": 4},      "traditional": {"S": 2, "M": 4, "L": 8}},
    "batch_job":         {"phase": "implementation", "label": "バッチ・ジョブ・スケジュール処理",   "actual": {"S": 1, "M": 3, "L": 6},      "traditional": {"S": 2, "M": 5, "L": 10}},
    "external_api":      {"phase": "implementation", "label": "外部API連携",                        "actual": {"S": 2, "M": 4, "L": 8},      "traditional": {"S": 3, "M": 6, "L": 12}},
    "mail_notification": {"phase": "implementation", "label": "メール・通知",                       "actual": {"S": 0.5, "M": 1.5, "L": 3},  "traditional": {"S": 1, "M": 3, "L": 6}},
    "file_io":           {"phase": "implementation", "label": "CSV・ファイルの入出力",              "actual": {"S": 1, "M": 2.5, "L": 5},    "traditional": {"S": 2, "M": 5, "L": 10}},
    "automated_test":    {"phase": "test",           "label": "自動テスト作成・修正",               "actual": {"S": 0.5, "M": 1.5, "L": 3},  "traditional": {"S": 1, "M": 3, "L": 6}},
    "manual_test":       {"phase": "test",           "label": "手動テスト・動作確認",               "actual": {"S": 0.5, "M": 1, "L": 2},    "traditional": {"S": 0.5, "M": 1.5, "L": 3}},
    "regression_test":   {"phase": "test",           "label": "回帰確認（既存機能への影響確認）",   "actual": {"S": 0.5, "M": 1, "L": 2},    "traditional": {"S": 0.5, "M": 1.5, "L": 3}},
    "review_fix":        {"phase": "review",         "label": "レビュー対応・修正",                 "actual": {"S": 0.5, "M": 1, "L": 2},    "traditional": {"S": 0.5, "M": 1.5, "L": 3}},
    "release":           {"phase": "release",        "label": "リリース作業・本番確認",             "actual": {"S": 0.5, "M": 1, "L": 2},    "traditional": {"S": 0.5, "M": 1, "L": 2}},
    "doc_update":        {"phase": "release",        "label": "ドキュメント・手順書の更新",         "actual": {"S": 0.25, "M": 0.5, "L": 1}, "traditional": {"S": 0.5, "M": 1, "L": 2}}
  },
  "coefficients": {
    "uncertainty":   {"low": 1.0, "mid": 1.2,  "high": 1.5},
    "complexity":    {"low": 1.0, "mid": 1.15, "high": 1.3},
    "unfamiliarity": {"none": 1.0, "partial": 1.2, "new": 1.5}
  },
  "buffer_rate": {"low": 0.1, "mid": 0.2, "high": 0.3},
  "custom_traditional_ratio": 1.8,
  "warnings": {
    "custom_ratio_threshold": 0.3
  }
}
